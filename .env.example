# Agent API endpoint (HTTP REST)
VITE_AGENT_API_URL=http://localhost:8000

# Agent WebSocket endpoint
VITE_AGENT_WS_URL=ws://localhost:8000/ws

# Bearer token for agent API authentication (optional)
VITE_AGENT_API_TOKEN=

# Transport type: http | websocket | sse
VITE_AGENT_TRANSPORT=http

# Application display name
VITE_APP_NAME=Front-UI

# Enable verbose debug logging
VITE_ENABLE_DEBUG=false
